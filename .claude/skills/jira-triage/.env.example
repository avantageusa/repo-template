# jira-triage skill — environment variables
#
# Export these into the shell/session the agent runs in (or a gitignored .env you
# source yourself). The agent does NOT read this file — the org `protect-secrets`
# hook blocks reading `.env`. Non-secret values come from the skill's Config block
# or by asking you; the one secret below is used only via the already-loaded
# process env at send time and is never printed.

# --- Jira ---
ATLASSIAN_CLOUD_ID=            # cloudId for the Jira site (getAccessibleAtlassianResources)
JIRA_PROJECT=ENGR             # project key (Avantage default)
BACKLOG_PARENT=ENGR-1758      # On-Call / Ad-hoc epic whose children get triaged (Avantage default)
OPERATOR_ACCOUNT_ID=          # the running user's Jira accountId — assignee when a build starts

# --- GitHub ---
GITHUB_ORG=                   # org to search / clone from, e.g. avantageusa
CODE_ROOT=                    # optional: local path to cloned repos; if set + repo present, grep locally
FRESHNESS_DAYS=30             # "recently pushed" cutoff for the freshness bootstrap

# --- GrowthBook (read live feature-flag values during triage) ---
GROWTHBOOK_CLIENT_KEY=              # SDK client key (public); per environment — player/portal vs back-office differ
GROWTHBOOK_API_HOST=https://cdn.growthbook.io

# --- Notifications ---
# SECRET — never commit the real value, never echo it. Incoming webhook the auto-PR flow posts to.
TEAMS_WEBHOOK_URL=
